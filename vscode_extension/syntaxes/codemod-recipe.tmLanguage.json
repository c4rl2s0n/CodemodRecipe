{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "injectionSelector": "L:meta.map.key.yaml",
  "patterns": [
    {
      "include": "#step-kinds"
    },
    {
      "include": "#op-kinds"
    },
    {
      "include": "#field-keys"
    }
  ],
  "repository": {
    "field-keys": {
      "comment": "Known DSL field names (recipe, map, variables, steps, ops, args, let).",
      "match": "(?<![\\w-])(abbr|allowCustomValue|anchor|args|as|capture|contextKey|defaultsTo|description|extract|help|id|ifExists|ifMissing|includeLeadingTrivia|inputKind|join|language|let|map|maps|name|onManyMatches|onNoMatch|ops|options|path|postExecution|queries|query|required|steps|template|templateFile|text|values|when|whenNot|with)(?![\\w-])",
      "name": "entity.name.tag.codemod-recipe.field"
    },
    "op-kinds": {
      "comment": "Edit operation discriminators (insert/replace/remove).",
      "match": "(?<![\\w-])(insert|remove|replace)(?![\\w-])",
      "name": "storage.type.codemod-recipe.op"
    },
    "step-kinds": {
      "comment": "Recipe step discriminators (edit/create/delete/recipe).",
      "match": "(?<![\\w-])(create|delete|edit|recipe)(?![\\w-])",
      "name": "keyword.control.codemod-recipe.step"
    }
  },
  "scopeName": "codemod-recipe.keys.injection"
}
