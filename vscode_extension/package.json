{
  "name": "codemod-recipe",
  "displayName": "Codemod Recipe",
  "description": "Browse, run, and review codemod_recipe transformations with an interactive diff and selective apply.",
  "version": "0.1.0",
  "publisher": "codemod-recipe",
  "repository": {
    "type": "git",
    "url": "https://github.com/c4rl2s0n/CodemodRecipe"
  },
  "license": "BSD-3-Clause",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "grammars": [
      {
        "scopeName": "codemod-recipe.keys.injection",
        "path": "./syntaxes/codemod-recipe.tmLanguage.json",
        "injectTo": [
          "source.yaml"
        ]
      },
      {
        "scopeName": "codemod-recipe.values.injection",
        "path": "./syntaxes/codemod-recipe-values.tmLanguage.json",
        "injectTo": [
          "source.yaml"
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codemodRecipe",
          "title": "Codemod Recipe",
          "icon": "media/recipe.svg"
        }
      ]
    },
    "views": {
      "codemodRecipe": [
        {
          "type": "webview",
          "id": "codemodRecipe.runner",
          "name": "Codemod Recipe",
          "icon": "media/recipe.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "codemodRecipe.refresh",
        "title": "Codemod Recipe: Refresh Recipes",
        "icon": "$(refresh)"
      },
      {
        "command": "codemodRecipe.bootstrap",
        "title": "Codemod Recipe: Restart Host",
        "icon": "$(debug-restart)"
      },
      {
        "command": "codemodRecipe.scaffoldProject",
        "title": "Codemod Recipe: Scaffold Project",
        "icon": "$(file-directory-create)"
      },
      {
        "command": "codemodRecipe.runRecipe",
        "title": "Codemod Recipe: Run Recipe",
        "icon": "$(play)"
      },
      {
        "command": "codemodRecipe.runFromCursorContext",
        "title": "Codemod Recipe: Run From Cursor Context",
        "icon": "$(wand)"
      },
      {
        "command": "codemodRecipe.runFromExplorer",
        "title": "Codemod Recipe: Run Recipe Here…",
        "icon": "$(play)"
      },
      {
        "command": "codemodRecipe.invoke",
        "title": "Codemod Recipe: Invoke Recipe"
      },
      {
        "command": "codemodRecipe.invokeSlot",
        "title": "Codemod Recipe: Invoke Slot"
      },
      {
        "command": "codemodRecipe.copyInvokeKeybinding",
        "title": "Codemod Recipe: Copy Invoke Keybinding"
      },
      {
        "command": "codemodRecipe.assignToSlot",
        "title": "Codemod Recipe: Assign to Slot"
      },
      {
        "command": "codemodRecipe.copySlotKeybinding",
        "title": "Codemod Recipe: Copy Slot Keybinding"
      },
      {
        "command": "codemodRecipe.configureHost",
        "title": "Codemod Recipe: Set Codemod Root Directory"
      },
      {
        "command": "codemodRecipe.validateRecipes",
        "title": "Codemod Recipe: Validate Recipes",
        "icon": "$(check-all)"
      },
      {
        "command": "codemodRecipe.openInRecipeRunner",
        "title": "Codemod Recipe: Open in Recipe Runner"
      },
      {
        "command": "codemodRecipe.testQueryOnFile",
        "title": "Codemod Recipe: Test Query on File"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          ".codemod/**/*.yaml",
          ".codemod/**/*.yml"
        ],
        "url": "./schemas/recipe.schema.json"
      },
      {
        "fileMatch": [
          ".codemod/maps/**/*.yaml",
          ".codemod/maps/**/*.yml"
        ],
        "url": "./schemas/map.schema.json"
      },
      {
        "fileMatch": [
          ".codemod/variables/**/*.yaml",
          ".codemod/variables/**/*.yml"
        ],
        "url": "./schemas/variables.schema.json"
      }
    ],
    "keybindings": [
      {
        "command": "codemodRecipe.runFromCursorContext",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "codemodRecipe.invokeSlot",
        "key": "ctrl+shift+i 1",
        "mac": "cmd+shift+i 1",
        "when": "editorTextFocus",
        "args": {
          "slot": "1",
          "mode": "auto"
        }
      },
      {
        "command": "codemodRecipe.invokeSlot",
        "key": "ctrl+shift+t 1",
        "mac": "cmd+shift+t 1",
        "when": "editorTextFocus",
        "args": {
          "slot": "1",
          "mode": "open"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codemodRecipe.refresh",
          "when": "view == codemodRecipe.runner",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "codemodRecipe.runFromCursorContext",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "codemodRecipe.explorer",
          "group": "navigation@90"
        }
      ],
      "codemodRecipe.explorer": [
        {
          "command": "codemodRecipe.runFromExplorer",
          "group": "navigation"
        }
      ]
    },
    "submenus": [
      {
        "id": "codemodRecipe.explorer",
        "label": "Codemod Recipe"
      }
    ],
    "configuration": {
      "title": "Codemod Recipe",
      "properties": {
        "codemodRecipe.workspaceRoot": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the workspace root directory. If empty, uses the currently open VSCode workspace folder."
        },
        "codemodRecipe.codemodRoot": {
          "type": "string",
          "default": ".codemod",
          "description": "Workspace-relative path to the codemod root directory containing YAML recipes, maps, and .template files."
        },
        "codemodRecipe.performanceLogging": {
          "type": "boolean",
          "default": false,
          "description": "Enable performance timing logs for list/preview/apply host calls."
        },
        "codemodRecipe.autoPreviewDebounceMs": {
          "type": "number",
          "default": 400,
          "minimum": 100,
          "maximum": 2000,
          "description": "Debounce delay (milliseconds) for automatic preview updates."
        },
        "codemodRecipe.previewSnippetLines": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Maximum number of lines shown per file in compact live preview cards."
        },
        "codemodRecipe.slots": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "string"
          },
          "description": "Map of slot ids (any character key, e.g. \"1\", \"b\") to recipe ids for codemodRecipe.invokeSlot."
        },
        "codemodRecipe.shortcutConfirmApply": {
          "type": "boolean",
          "default": false,
          "description": "When a shortcut would auto-apply a recipe with complete args, ask for confirmation first."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "vite build --config src/webview/vite.config.ts",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "watch:webview": "vite build --config src/webview/vite.config.ts --watch",
    "test:webview": "vitest run --config src/webview/vitest.config.ts",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.4.0",
    "vite": "^5.4.14",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  }
}