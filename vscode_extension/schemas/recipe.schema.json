{
  "$id": "https://codemod-recipe.dev/schemas/recipe.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "definitions": {
    "ExplorerMenuKind": {
      "description": "Explorer resource kind for a menu entry.",
      "enum": [
        "file",
        "folder"
      ],
      "type": "string"
    },
    "LetExtract": {
      "enum": [
        "text",
        "kind",
        "exists",
        "count"
      ],
      "type": "string"
    },
    "LetOnManyMatches": {
      "enum": [
        "error",
        "first",
        "join"
      ],
      "type": "string"
    },
    "LetOnNoMatch": {
      "enum": [
        "error",
        "use"
      ],
      "type": "string"
    },
    "anchor": {
      "enum": [
        "start",
        "end"
      ],
      "type": "string"
    },
    "arg": {
      "additionalProperties": true,
      "properties": {
        "abbr": {
          "default": null,
          "description": "Short CLI abbreviation for a recipe arg.",
          "type": "string"
        },
        "allowCustomValue": {
          "default": null,
          "description": "Allow values outside options for choice args.",
          "type": "boolean"
        },
        "contextKey": {
          "default": null,
          "description": "Deprecated alias of string `from` — editor context key used to prefill this arg.",
          "type": "string"
        },
        "defaultsTo": {
          "default": null,
          "description": "Default value when the arg is omitted.",
          "type": "string"
        },
        "from": {
          "allOf": [
            {
              "$ref": "#/definitions/argFrom"
            }
          ],
          "default": null,
          "description": "Derive this arg from editor context (`file`, query, template, …)."
        },
        "help": {
          "default": null,
          "description": "Help text shown in the recipe runner.",
          "type": "string"
        },
        "inputKind": {
          "allOf": [
            {
              "$ref": "#/definitions/inputKind"
            }
          ],
          "default": null,
          "description": "Runner input widget kind for a recipe arg."
        },
        "name": {
          "description": "Human-readable recipe name.",
          "type": "string"
        },
        "options": {
          "default": [],
          "description": "Allowed values for choice-style args.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "required": {
          "default": false,
          "description": "Whether the recipe arg must be provided.",
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "argFrom": {
      "additionalProperties": true
    },
    "createStep": {
      "additionalProperties": true,
      "properties": {
        "if": {
          "default": null,
          "description": "Run nested steps when shared if / ifNot MiniJinja expressions pass.",
          "type": "string"
        },
        "ifExists": {
          "$ref": "#/definitions/ifExists",
          "description": "Behavior when create target path already exists."
        },
        "ifNot": {
          "default": null,
          "description": "MiniJinja expression over recipe args; skip the step when true.",
          "type": "string"
        },
        "path": {
          "description": "Workspace-relative file path (often templated).",
          "type": "string"
        },
        "template": {
          "default": null,
          "description": "Inline file content for a create step.",
          "type": "string"
        },
        "templateFile": {
          "default": null,
          "description": "Template path resolved recipe-local first, then under .codemod.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "deleteStep": {
      "additionalProperties": true,
      "properties": {
        "if": {
          "default": null,
          "description": "Run nested steps when shared if / ifNot MiniJinja expressions pass.",
          "type": "string"
        },
        "ifMissing": {
          "$ref": "#/definitions/ifMissing",
          "description": "Behavior when delete target path is missing."
        },
        "ifNot": {
          "default": null,
          "description": "MiniJinja expression over recipe args; skip the step when true.",
          "type": "string"
        },
        "path": {
          "description": "Workspace-relative file path (often templated).",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "editOp": {
      "additionalProperties": false,
      "maxProperties": 1,
      "minProperties": 1,
      "properties": {
        "insert": {
          "$ref": "#/definitions/insertOp",
          "description": "Insert text at a capture anchor (start or end)."
        },
        "remove": {
          "$ref": "#/definitions/removeOp",
          "description": "Remove the span matched by a query capture."
        },
        "replace": {
          "$ref": "#/definitions/replaceOp",
          "description": "Replace the span of a query capture with new text."
        }
      },
      "type": "object"
    },
    "editStep": {
      "additionalProperties": true,
      "properties": {
        "if": {
          "default": null,
          "description": "Run nested steps when shared if / ifNot MiniJinja expressions pass.",
          "type": "string"
        },
        "ifNot": {
          "default": null,
          "description": "MiniJinja expression over recipe args; skip the step when true.",
          "type": "string"
        },
        "language": {
          "default": null,
          "description": "Tree-sitter language id when extension inference is ambiguous.",
          "type": "string"
        },
        "let": {
          "$ref": "#/definitions/letBindings",
          "description": "Step-local bindings recomputed before each op."
        },
        "ops": {
          "description": "Ordered edit operations applied sequentially on the same file.",
          "items": {
            "$ref": "#/definitions/editOp"
          },
          "type": "array"
        },
        "path": {
          "description": "Workspace-relative file path (often templated).",
          "type": "string"
        },
        "when": {
          "$ref": "#/definitions/queryField",
          "description": "Guard queries; all must match before the edit runs."
        },
        "whenNot": {
          "$ref": "#/definitions/queryField",
          "description": "Forbidden guard queries; edit runs only if none match."
        }
      },
      "required": [
        "ops",
        "path"
      ],
      "type": "object"
    },
    "explorerMenu": {
      "oneOf": [
        {
          "$ref": "#/definitions/explorerMenuEntry"
        },
        {
          "items": {
            "$ref": "#/definitions/explorerMenuEntry"
          },
          "type": "array"
        }
      ]
    },
    "explorerMenuEntry": {
      "additionalProperties": true,
      "description": "One Explorer menu rule: match `kind`, optionally gate on MiniJinja `if` over `path`.",
      "properties": {
        "args": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Recipe arg name → MiniJinja expression over click `path` only.",
          "type": "object"
        },
        "if": {
          "description": "Run nested steps when shared if / ifNot MiniJinja expressions pass.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ExplorerMenuKind"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "ifExists": {
      "enum": [
        "fail",
        "skip"
      ],
      "type": "string"
    },
    "ifMissing": {
      "enum": [
        "fail",
        "skip"
      ],
      "type": "string"
    },
    "ifStep": {
      "additionalProperties": true,
      "description": "Authoring shape for an `if:` step group (`if` / `ifNot` / `steps`).",
      "properties": {
        "if": {
          "default": null,
          "description": "Run nested steps when shared if / ifNot MiniJinja expressions pass.",
          "type": "string"
        },
        "ifNot": {
          "default": null,
          "description": "MiniJinja expression over recipe args; skip the step when true.",
          "type": "string"
        },
        "steps": {
          "description": "Ordered list of edit, create, delete, recipe, or if group steps.",
          "items": {
            "$ref": "#/definitions/step"
          },
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "type": "object"
    },
    "inputKind": {
      "description": "Known `inputKind` values for schema/completions; parse still accepts any string.",
      "enum": [
        "text",
        "file",
        "directory",
        "choice"
      ],
      "type": "string"
    },
    "insertOp": {
      "additionalProperties": true,
      "properties": {
        "anchor": {
          "$ref": "#/definitions/anchor",
          "description": "Insertion anchor relative to the capture (start or end)."
        },
        "capture": {
          "description": "Capture name from the query whose span is edited.",
          "type": "string"
        },
        "query": {
          "$ref": "#/definitions/queryField",
          "description": "Inline tree-sitter query, .scm path, query-library ref, or chain."
        },
        "text": {
          "description": "Replacement or inserted source text (Jinja-rendered).",
          "type": "string"
        }
      },
      "required": [
        "anchor",
        "capture",
        "query",
        "text"
      ],
      "type": "object"
    },
    "letBinding": {
      "additionalProperties": true,
      "properties": {
        "as": {
          "default": null,
          "description": "Optional template to compute final value from prior locals (and recipe args).",
          "type": "string"
        },
        "capture": {
          "default": null,
          "description": "Capture name from the query whose span is edited.",
          "type": "string"
        },
        "extract": {
          "allOf": [
            {
              "$ref": "#/definitions/LetExtract"
            }
          ],
          "default": "text",
          "description": "How to derive a let binding value from query captures."
        },
        "join": {
          "default": null,
          "description": "Separator when onManyMatches is join.",
          "type": "string"
        },
        "name": {
          "description": "Human-readable recipe name.",
          "type": "string"
        },
        "onManyMatches": {
          "allOf": [
            {
              "$ref": "#/definitions/LetOnManyMatches"
            }
          ],
          "default": "error",
          "description": "Behavior when a let binding query matches multiple nodes."
        },
        "onNoMatch": {
          "allOf": [
            {
              "$ref": "#/definitions/LetOnNoMatch"
            }
          ],
          "default": "error",
          "description": "Behavior when a let binding query matches nothing."
        },
        "query": {
          "allOf": [
            {
              "$ref": "#/definitions/queryField"
            }
          ],
          "default": null,
          "description": "Inline tree-sitter query, .scm path, query-library ref, or chain."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "letBindings": {
      "oneOf": [
        {
          "items": {
            "$ref": "#/definitions/letBinding"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/definitions/letBinding"
          },
          "type": "object"
        }
      ]
    },
    "postExecutionItem": {
      "type": "string"
    },
    "queryDefinition": {
      "additionalProperties": true,
      "properties": {
        "query": {
          "description": "Inline tree-sitter query, .scm path, query-library ref, or chain.",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "queryField": {
      "description": "Tree-sitter query string or a non-empty list of query steps",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        }
      ]
    },
    "recipeRef": {
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "$ref": "#/definitions/recipeRefObject"
        }
      ]
    },
    "recipeRefObject": {
      "additionalProperties": true,
      "description": "Reference to another recipe, optionally with call-site arg bindings.",
      "properties": {
        "id": {
          "description": "Unique recipe identifier.",
          "type": "string"
        },
        "if": {
          "default": null,
          "description": "Run nested steps when shared if / ifNot MiniJinja expressions pass.",
          "type": "string"
        },
        "ifNot": {
          "default": null,
          "description": "MiniJinja expression; skip the inlined recipe when true.",
          "type": "string"
        },
        "with": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Child arg name → template string rendered in the parent context.",
          "type": "object"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "removeOp": {
      "additionalProperties": true,
      "properties": {
        "capture": {
          "description": "Capture name from the query whose span is edited.",
          "type": "string"
        },
        "includeLeadingTrivia": {
          "default": false,
          "description": "Include leading trivia when replacing or removing a capture.",
          "type": "boolean"
        },
        "query": {
          "$ref": "#/definitions/queryField",
          "description": "Inline tree-sitter query, .scm path, query-library ref, or chain."
        }
      },
      "required": [
        "capture",
        "query"
      ],
      "type": "object"
    },
    "replaceOp": {
      "additionalProperties": true,
      "properties": {
        "capture": {
          "description": "Capture name from the query whose span is edited.",
          "type": "string"
        },
        "includeLeadingTrivia": {
          "default": false,
          "description": "Include leading trivia when replacing or removing a capture.",
          "type": "boolean"
        },
        "query": {
          "$ref": "#/definitions/queryField",
          "description": "Inline tree-sitter query, .scm path, query-library ref, or chain."
        },
        "text": {
          "description": "Replacement or inserted source text (Jinja-rendered).",
          "type": "string"
        }
      },
      "required": [
        "capture",
        "query",
        "text"
      ],
      "type": "object"
    },
    "step": {
      "additionalProperties": false,
      "maxProperties": 1,
      "minProperties": 1,
      "properties": {
        "create": {
          "$ref": "#/definitions/createStep",
          "description": "Create a new file from inline template or templateFile."
        },
        "delete": {
          "$ref": "#/definitions/deleteStep",
          "description": "Delete a file from the workspace."
        },
        "edit": {
          "$ref": "#/definitions/editStep",
          "description": "Patch an existing file with tree-sitter insert, replace, or remove ops."
        },
        "if": {
          "$ref": "#/definitions/ifStep",
          "description": "Run nested steps when shared if / ifNot MiniJinja expressions pass."
        },
        "recipe": {
          "$ref": "#/definitions/recipeRef",
          "description": "Inline another recipe by id, optionally with call-site with bindings."
        }
      },
      "type": "object"
    }
  },
  "properties": {
    "args": {
      "description": "Recipe argument definitions shown in the runner UI.",
      "items": {
        "$ref": "#/definitions/arg"
      },
      "type": "array"
    },
    "description": {
      "default": null,
      "description": "Short recipe description.",
      "type": "string"
    },
    "explorerMenu": {
      "allOf": [
        {
          "$ref": "#/definitions/explorerMenu"
        }
      ],
      "default": null,
      "description": "Opt-in for VS Code Explorer context QuickPick (`kind` + optional path `if`)."
    },
    "id": {
      "description": "Unique recipe identifier.",
      "type": "string"
    },
    "maps": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "default": {},
      "description": "Recipe-local map entries merged with workspace maps.",
      "type": "object"
    },
    "name": {
      "default": null,
      "description": "Human-readable recipe name.",
      "type": "string"
    },
    "postExecution": {
      "description": "Post-apply shell commands or script paths under the codemod root (Jinja-rendered).",
      "items": {
        "$ref": "#/definitions/postExecutionItem"
      },
      "type": "array"
    },
    "queries": {
      "additionalProperties": {
        "$ref": "#/definitions/queryDefinition"
      },
      "description": "Recipe-local named query definitions.",
      "type": "object"
    },
    "steps": {
      "description": "Ordered list of edit, create, delete, recipe, or if group steps.",
      "items": {
        "$ref": "#/definitions/step"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "steps"
  ],
  "title": "Codemod Recipe",
  "type": "object"
}
