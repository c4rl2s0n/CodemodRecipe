{
  "$id": "https://codemod-recipe.dev/schemas/map.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "description": {
      "description": "Short recipe description.",
      "type": "string"
    },
    "id": {
      "description": "Unique recipe identifier.",
      "minLength": 1,
      "type": "string"
    },
    "map": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map lookup table for a workspace map YAML asset (requires id).",
      "type": "object"
    }
  },
  "required": [
    "id",
    "map"
  ],
  "title": "Codemod Recipe Map",
  "type": "object"
}
