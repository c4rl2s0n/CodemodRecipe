{
  "$id": "https://codemod-recipe.dev/schemas/variables.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
    "description": {
      "description": "Short recipe description.",
      "type": "string"
    },
    "id": {
      "description": "Unique recipe identifier.",
      "minLength": 1,
      "type": "string"
    },
    "values": {
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "description": "Constant values for a workspace variables YAML asset (requires id).",
      "type": "object"
    }
  },
  "required": [
    "id",
    "values"
  ],
  "title": "Codemod Recipe Variables",
  "type": "object"
}
