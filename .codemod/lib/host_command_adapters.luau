function M.mcpToolSpecs()
	return MCP_TOOL_SPECS
end

--- Insert a tools/list row before `run_tests` (createCommand MCP layer).
--- Mutates the in-memory table so writeExpected sees the new tool before reload.
function M.addMcpToolSpec(spec)
	for i, row in ipairs(MCP_TOOL_SPECS) do
		if row.name == "run_tests" then
			table.insert(MCP_TOOL_SPECS, i, spec)
			return
		end
	end
	MCP_TOOL_SPECS[#MCP_TOOL_SPECS + 1] = spec
end

local function snakeToCamel(name)
	return (name:gsub("_(%w)", function(ch)
		return ch:upper()
	end))
end

local function fieldWireName(rustName, fieldSrc)
	local rename = fieldSrc:match('%#%[%s*serde%s*%(%s*[^%)]*rename%s*=%s*"([^"]+)"')
	if rename then
		return rename
	end
	return snakeToCamel(rustName)
end

local function isOptionalRustType(ty)
	if ty:find("^Option%s*<", 1) or ty:find("^std::option::Option%s*<", 1) then
		return true
	end
	if ty:find("%#%[%s*serde%s*%([^%)]*default", 1) then
		return true
	end
	return false
end

local function mapRustTypeToTs(ty, wireName, variant)
	-- Intentional TS sharpenings (hand overrides).
	if variant == "Apply" and wireName == "selection" then
		return "SelectionPayload"
	end
	if wireName == "args" then
		return "ArgValues"
	end
	if wireName == "context" and variant == "DeriveArgs" then
		return "Record<string, string>"
	end
	if wireName == "kind" and variant == "FilterExplorerRecipes" then
		return "'file' | 'folder'"
	end

	local t = ty:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
	-- Strip Option<…>
	local inner = t:match("^Option%s*<%s*(.+)%s*>$") or t:match("^std::option::Option%s*<%s*(.+)%s*>$")
	if inner then
		t = inner:gsub("%s+$", "")
	end
	if t == "String" or t == "str" or t:find("&%s*str") then
		return "string"
	end
	if t == "bool" then
		return "boolean"
	end
	if t == "u32" or t == "u64" or t == "i32" or t == "i64" or t == "usize" or t == "f64" or t == "f32" then
		return "number"
	end
	if t:find("serde_json::Value") or t == "Value" then
		return "unknown"
	end
	if t:find("Vec%s*<") then
		local elem = t:match("Vec%s*<%s*(.-)%s*>")
		if elem == "String" then
			return "string[]"
		end
		return "unknown[]"
	end
	if t:find("BTreeMap") or t:find("HashMap") then
		if t:find("serde_json::Value") then
			return "ArgValues"
		end
		if t:find("String%s*,%s*String") then
			return "Record<string, string>"
		end
		return "Record<string, unknown>"
	end
	return "unknown"
end

--- Collect all enum struct fields once, then partition by variant span.
local function collectAllFields(c, path)
	local fieldsByIndex = {}
	local ok = pcall(function()
		local names = c:query({
			path = path,
			language = "rust",
			query = "repo_rust.enum_variant_fields",
			capture = "fieldName",
		})
		local types = c:query({
			path = path,
			language = "rust",
			query = "repo_rust.enum_variant_fields",
			capture = "fieldType",
		})
		local items = c:query({
			path = path,
			language = "rust",
			query = "repo_rust.enum_variant_fields",
			capture = "fieldItem",
		})
		local src = c:read(path)
		for i = 1, math.min(#names, #types, #items) do
			local item = items[i]
			local fieldSrc = src:sub(item.span.from + 1, item.span.to)
			local rustName = names[i].text
			local tyText = types[i].text or ""
			local wire = fieldWireName(rustName, fieldSrc)
			local optional = isOptionalRustType(tyText) or fieldSrc:find("%#%[%s*serde%s*%([^%)]*default", 1) ~= nil
			fieldsByIndex[#fieldsByIndex + 1] = {
				span = item.span,
				rustName = rustName,
				wireName = wire,
				rustType = tyText,
				optional = optional,
			}
		end
	end)
	if not ok then
		return {}
	end
	return fieldsByIndex
end

local function fieldsInSpan(allFields, variantSpan)
	local fields = {}
	for _, f in ipairs(allFields) do
		if f.span.from >= variantSpan.from and f.span.to <= variantSpan.to then
			fields[#fields + 1] = {
				rustName = f.rustName,
				wireName = f.wireName,
				rustType = f.rustType,
				optional = f.optional,
			}
		end
	end
	return fields
end

--- Parse HostCommand variants (+ fields) from command.rs.
--- Uses full enum_variant spans (not name-only) so struct fields are in-range.
function M.parseVariants(c, commandRsPath)
	commandRsPath = commandRsPath or M.COMMAND_RS
	local paired = hostCommand.parseEnum(c, commandRsPath)
	local items = {}
	pcall(function()
		items = c:query({
			path = commandRsPath,
			language = "rust",
			query = "repo_rust.host_command_variant_items",
			capture = "variantItem",
		})
	end)
	table.sort(items, function(a, b)
		return a.span.from < b.span.from
	end)
	local allFields = collectAllFields(c, commandRsPath)
	local out = {}
	for i, row in ipairs(paired) do
		local span = row.span
		-- Prefer full variant node span when available (same order as paired names).
		if items[i] then
			span = items[i].span
		end
		out[#out + 1] = {
			variant = row.variant,
			rename = row.rename,
			span = span,
			fields = fieldsInSpan(allFields, span),
		}
	end
	return out
end

local function renderTsMember(v)
	local rename = v.rename or (v.variant and v.variant:sub(1, 1):lower() .. v.variant:sub(2))
	if not v.fields or #v.fields == 0 then
		return "  | { command: '" .. rename .. "' }"
	end
	local lines = { "  | {" }
	lines[#lines + 1] = "      command: '" .. rename .. "';"
	for _, f in ipairs(v.fields) do
		local tsType = mapRustTypeToTs(f.rustType, f.wireName, v.variant)
		local opt = f.optional and "?" or ""
		lines[#lines + 1] = "      " .. f.wireName .. opt .. ": " .. tsType .. ";"
	end
	lines[#lines + 1] = "    }"
	return table.concat(lines, "\n")
end

function M.renderHostCommandTs(variants)
	local parts = { TS_HEADER, "export type HostCommand =" }
	for _, v in ipairs(variants) do
		if v.rename then
			parts[#parts + 1] = renderTsMember(v)
		end
	end
	parts[#parts + 1] = ";"
	parts[#parts + 1] = ""
	return table.concat(parts, "\n")
end

local function escapeRsString(s)
	return (s:gsub("\\", "\\\\"):gsub('"', '\\"'))
end

function M.renderMcpInventoryRs(_variants)
	-- variants used by verify for hostCommand existence; render uses MCP_TOOL_SPECS.
	local lines = { RS_HEADER, "use super::McpToolMeta;", "", "pub fn generated_tool_metas() -> &'static [McpToolMeta] {", "    &[", }
	for _, spec in ipairs(MCP_TOOL_SPECS) do
		local hc
		if spec.hostCommand then
			hc = 'Some("' .. spec.hostCommand .. '")'
		else
			hc = "None"
		end
		lines[#lines + 1] = "        McpToolMeta {"
		lines[#lines + 1] = '            name: "' .. spec.name .. '",'
		lines[#lines + 1] = '            description: "' .. escapeRsString(spec.description) .. '",'
		lines[#lines + 1] = "            host_command: " .. hc .. ","
		lines[#lines + 1] = "        },"
	end
	lines[#lines + 1] = "    ]"
	lines[#lines + 1] = "}"
	lines[#lines + 1] = ""
	return table.concat(lines, "\n")
end

function M.expectedFiles(c, commandRsPath)
	local variants = M.parseVariants(c, commandRsPath or M.COMMAND_RS)
	return {
		[M.HOST_COMMAND_G_TS] = M.renderHostCommandTs(variants),
		[M.MCP_INVENTORY_G_RS] = M.renderMcpInventoryRs(variants),
	}, variants
end

--- Write both generated adapters (shared by syncAdapters op + createCommand).
--- Uses whole-file `c:replace` (no `c:writeFile` host method); falls back to create.
function M.writeExpected(c, commandRsPath)
	local files = M.expectedFiles(c, commandRsPath)
	for path, content in pairs(files) do
		local lang, root = "rust", "source_file"
		if path:match("%.ts$") then
			lang, root = "typescript", "program"
		end
		local ok = pcall(function()
			c:replace({
				path = path,
				language = lang,
				query = "(" .. root .. ") @file",
				capture = "file",
				text = content,
			})
		end)
		if not ok then
			-- File missing or unparseable: create fresh (Fail ifExists if already present).
			pcall(function()
				c:delete({ path = path, ifMissing = "skip" })
			end)
			c:create({ path = path, content = content })
		end
	end
end

function M.diffGenerated(diskText, expectedText)
	if diskText == expectedText then
		return nil
	end
	return {
		kind = "drift",
		diskLen = diskText and #diskText or 0,
		expectedLen = expectedText and #expectedText or 0,
	}
end

--- Findings for MCP_TOOL_SPECS → enum integrity (not byte drift).
function M.mcpSpecFindings(variants)
	local byVariant = {}
	for _, v in ipairs(variants) do
		byVariant[v.variant] = true
	end
	local findings = {}
	for _, spec in ipairs(MCP_TOOL_SPECS) do
		if spec.hostCommand and not byVariant[spec.hostCommand] then
			findings[#findings + 1] = {
				severity = "error",
				code = "adapter.mcp_unknown_variant",
				message = "MCP tool '"
					.. spec.name
					.. "' maps to unknown HostCommand::"
					.. spec.hostCommand,
			}
		end
	end
	return findings
end

return M
