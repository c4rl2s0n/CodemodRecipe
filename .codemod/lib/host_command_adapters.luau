--- Shared HostCommand adapter parse/render for syncAdapters + verify.
--- Pure over AST / strings; no WorkingTree writes.

local hostCommand = require("./host_command")

local M = {}

M.COMMAND_RS = "rust/crates/host/src/protocol/command.rs"
M.HOST_COMMAND_G_TS = "vscode_extension/src/shared/hostCommand.g.ts"
M.MCP_INVENTORY_G_RS = "rust/crates/host/src/protocol/mcp_inventory.g.rs"

local TS_HEADER = [[// @generated by syncAdapters — DO NOT EDIT
// Source: rust/crates/host/src/protocol/command.rs
import type { ArgValues, SelectionPayload } from './types';

]]

local RS_HEADER = [[// @generated by syncAdapters — DO NOT EDIT
// Source: .codemod/lib/host_command_adapters.luau MCP_TOOL_SPECS (+ HostCommand variants).
// Hand schemas stay in mcp_inventory.rs (`input_schema`).

]]

