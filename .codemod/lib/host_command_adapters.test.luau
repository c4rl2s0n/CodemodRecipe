--- Golden tests for shared HostCommand adapter renderers.

local adapters = require("./host_command_adapters")

return {
	id = "repo.host_command_adapters.tests",
	target = "repo.host_protocol",
	tests = {
		render_ts_from_fixture_enum = function(t)
			-- Pure renderers: no workspace scan required.
			local variants = {
				{ variant = "List", rename = "list", fields = {} },
				{
					variant = "Validate",
					rename = "validate",
					fields = {
						{ rustName = "recipe", wireName = "recipe", rustType = "Option<String>", optional = true },
					},
				},
			}
			local ts = adapters.renderHostCommandTs(variants)
			t:assert(ts:find("@generated by syncAdapters", 1, true), "missing generated header")
			t:assert(ts:find("| { command: 'list' }", 1, true), "missing list member")
			t:assert(ts:find("command: 'validate'", 1, true), "missing validate")
			t:assert(ts:find("recipe?: string", 1, true), "missing optional recipe")
			local rs = adapters.renderMcpInventoryRs(variants)
			t:assert(rs:find("generated_tool_metas", 1, true), "missing metas fn")
			t:assert(rs:find('name: "list_recipes"', 1, true), "missing list_recipes")
			t:assertEq(adapters.diffGenerated(ts, ts), nil)
			t:assert(adapters.diffGenerated(ts, ts .. "x"), "expected drift")
		end,

		mcp_specs_flag_unknown_variant = function(t)
			local findings = adapters.mcpSpecFindings({
				{ variant = "List", rename = "list", fields = {} },
			})
			local unknown = 0
			for _, f in ipairs(findings) do
				if f.code == "adapter.mcp_unknown_variant" then
					unknown += 1
				end
			end
			t:assert(unknown > 0, "expected unknown variant findings when enum is incomplete")
		end,
	},
}
